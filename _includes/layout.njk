<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · BPA347</title>
<link rel="stylesheet" href="/assets/site.css">
</head>
<body>
<header class="top">
  <a class="brand" href="/">BPA347 · Digital Businesses and AI</a>
  <a class="download" href="/notes.zip">Download notes (zip)</a>
  {% if week %}<nav>
    <span class="week">{{ week | replace("week-", "Week ") }}</span>
    {% if collections.all | hasPage("/" ~ week ~ "/mon/") %}<a href="/{{ week }}/mon/">Mon</a>{% endif %}
    {% if collections.all | hasPage("/" ~ week ~ "/thu/") %}<a href="/{{ week }}/thu/">Thu</a>{% endif %}
    {% if collections.all | hasPage("/" ~ week ~ "/homework/") %}<a href="/{{ week }}/homework/">Homework</a>{% endif %}
  </nav>{% endif %}
</header>
<main>
{{ content | safe }}
</main>
<footer>University of Cyprus · Fall 2026. The notes are plain markdown files: <a href="/notes.zip">download the folder</a>, open a terminal in it, and ask your agent about them.</footer>
</body>
</html>
